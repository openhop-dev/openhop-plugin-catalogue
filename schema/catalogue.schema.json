{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhop.dev/schemas/plugin-catalogue-v2.json",
  "title": "openHop Plugin Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plugins"],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 2
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "repository",
          "distribution",
          "source_revision",
          "version",
          "wheel_url",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "distribution": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "logo": {
            "type": "string",
            "pattern": "^https://"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "wheel_url": {
            "type": "string",
            "pattern": "^https://repeater-plugins\\.openhop\\.dev/plugins/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "min_repeater_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "homepage": {
            "type": "string",
            "pattern": "^https://"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
