{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhop.dev/schemas/plugin-catalogue-v1.json",
  "title": "openHop Plugin Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plugins"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "repository"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "logo": {
            "type": "string",
            "minLength": 1,
            "description": "HTTPS URL to a plugin logo/icon image (png/svg/webp).",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
